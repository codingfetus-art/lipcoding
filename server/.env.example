# Optional Azure OCR/Blob features. Keep false unless those paid resources are prepared.
DOCUMENT_ACTION_AZURE_ENABLED=false

# Azure AI Document Intelligence
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<resource-name>.cognitiveservices.azure.com/
# AZURE_DOCUMENT_INTELLIGENCE_KEY=
# AZURE_DOCUMENT_INTELLIGENCE_MODEL=prebuilt-read

# Azure Blob Storage
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_CONTAINER=documents

# Azure Cosmos DB
# Set AZURE_COSMOS_ENDPOINT for required expense/reminder storage.
# If AZURE_COSMOS_KEY is omitted, DefaultAzureCredential uses Azure CLI login locally
# or Managed Identity on Azure.
# AZURE_COSMOS_ENDPOINT=
# AZURE_COSMOS_KEY=
# AZURE_COSMOS_DATABASE=docuagent
