# ---- Server ----
PORT=3001

# ---- Copilot SDK ----
# The Copilot SDK requires the GitHub Copilot CLI in PATH and a Copilot subscription.
# Auth is picked up from the `copilot` CLI login, or from one of these env vars:
# COPILOT_GITHUB_TOKEN / GH_TOKEN / GITHUB_TOKEN
# COPILOT_GITHUB_TOKEN=

# Model to use for the agent (must be available to your Copilot subscription)
COPILOT_MODEL=claude-sonnet-4.5

# ---- Azure (used in production; optional for local MVP) ----
# Azure AI Document Intelligence (Receipt/Invoice models) for accurate OCR.
# When empty, the agent falls back to model-vision / pasted text.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Azure Cosmos DB (production persistence). When empty, a local JSON file store is used.
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_KEY=
AZURE_COSMOS_DATABASE=docuagent

# Azure Blob Storage (original document archive). When empty, uploads are skipped.
# Use a connection string OR an account name with Managed Identity.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=documents

# Monthly budget per category (KRW) - simple defaults for the budget-analysis tool
MONTHLY_BUDGET_TOTAL=1000000
